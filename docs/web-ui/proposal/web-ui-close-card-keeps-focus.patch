         </div>
     }
 </div>
@@ -346,6 +351,7 @@
     private bool _closeAskBusy;
     private bool _closeAskFocus;
     private ElementReference _closeAskFirst;
+    private ElementReference _closeAskLast;
 
     /// <summary>TabsService.CloseGuard. Shows each tab in turn and asks. Marks chosen to be saved are saved at once;
     /// marks chosen to be discarded are dropped only when every tab has an answer, so Cancel loses nothing.</summary>
@@ -432,6 +438,12 @@
 
     private void AnswerClose(CloseAnswer answer) => _closeAnswer?.TrySetResult(answer);
 
+    private async Task FocusCloseAskAsync(bool last)
+    {
+        try { await (last ? _closeAskLast : _closeAskFirst).FocusAsync(); }
+        catch { }   // the card closed meanwhile
+    }
+
     private void OnCloseAskKey(KeyboardEventArgs e)
     {
         if (e.Key == "Escape" && !_closeAskBusy) AnswerClose(CloseAnswer.Cancel);
