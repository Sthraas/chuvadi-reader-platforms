             <div class="closeq-text">
                 @(ask.Tab.Marks?.Count == 1 ? "It has 1 mark that is not saved. It is lost" : $"It has {ask.Tab.Marks?.Count} marks that are not saved. They are lost") if you close without saving.
@@ -288,8 +292,9 @@
                 }
                 <button class="fc-btn danger" disabled="@_closeAskBusy" @onclick="() => AnswerClose(CloseAnswer.Discard)">Discard</button>
                 <span class="closeq-gap"></span>
-                <button class="fc-btn" disabled="@_closeAskBusy" @onclick="() => AnswerClose(CloseAnswer.Cancel)">Cancel</button>
+                <button class="fc-btn" @ref="_closeAskLast" disabled="@_closeAskBusy" @onclick="() => AnswerClose(CloseAnswer.Cancel)">Cancel</button>
             </div>
