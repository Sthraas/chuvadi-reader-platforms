+    // Phone (Portal & Android): open at fit width, not the desktop's 100 % (the page is wider than the
+    // screen). The width is measured by the phone's own script; tablets and desktops keep 100 %.
+    private async Task FitWidthOnPhoneAsync()
+    {
+        if (Platform.FormFactor != ChuvadiReader.Platform.FormFactor.Phone) return;
+        await using var mobile = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/mobile.js");
+        var fit = await mobile.InvokeAsync<double>("fitWidthZoom", _desk);
+        if (fit > 0 && Math.Abs(fit - _zoom) > 0.005)
+        {
+            _zoom = fit;
+            StateHasChanged();
+        }
+    }
