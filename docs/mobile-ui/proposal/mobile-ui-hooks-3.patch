+    for (let i = 0; i < 40 && deskEl && !deskEl.querySelector('.rpage svg'); i++) {
+        await new Promise(r => setTimeout(r, 50));
+    }
+    const rendered = deskEl && deskEl.querySelector('.rpage svg');
