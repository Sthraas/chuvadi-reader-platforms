+    // Tablet and phone: the desk footer's actions are in the desk's ··· menu (TouchDesks).
+    private bool TouchDesks => Platform.FormFactor != ChuvadiReader.Platform.FormFactor.Desktop;
+
+    private void DeskMenuDo(Action act)
+    {
+        _deskMenu = null;
+        act();
+    }
+
+    private Task DeskMenuDo(Func<Task> act)
+    {
+        _deskMenu = null;
+        return act();
+    }
+
     private async Task OpenDeskInReader(Guid deskId) => await BindDeskAndRoute(deskId, toRedact: false);
 
     private async Task SendDeskToRedact(Guid deskId) => await BindDeskAndRoute(deskId, toRedact: true);
