+    // D-205: Android's Back (button or gesture) while a question is on screen is Cancel, as Escape is. It is
+    // consumed even while a save runs, so the screen never moves under the question. Hosts without Back never raise it.
+    private bool OnBackOnQuestion()
+    {
+        if (_closeAsk is not null)
+        {
+            if (!_closeAskBusy) _ = InvokeAsync(() => AnswerClose(CloseAnswer.Cancel));
+            return true;
+        }
+
+        if (_pageOpAsk is not null)
+        {
+            _ = InvokeAsync(() => AnswerPageOp(false));
+            return true;
+        }
+
+        return false;
+    }
