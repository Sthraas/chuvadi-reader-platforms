diff --git a/src/ChuvadiReader.Core/Window/IHostChrome.cs b/src/ChuvadiReader.Core/Window/IHostChrome.cs
new file mode 100644
index 0000000..4164d41
--- /dev/null
+++ b/src/ChuvadiReader.Core/Window/IHostChrome.cs
@@ -0,0 +1,53 @@
+namespace ChuvadiReader.Core.Window;
+
+/// <summary>
+/// The few places where the shell's chrome and wording depend on where Chuvadi runs (desktop app or
+/// web portal). Every member defaults to today's desktop behaviour, so a host that registers
+/// <see cref="DesktopHostChrome"/> looks exactly as before. The web portal registers its own
+/// implementation (design: Portal &amp; Android 12b).
+/// </summary>
+public interface IHostChrome
+{
+    /// <summary>Minimise / maximise / close buttons at the right of the top bar.</summary>
+    bool ShowsWindowControls => true;
+
+    /// <summary>A component the host supplies for the right end of the top bar, shown where the window
+    /// controls would be (the portal's account button and menu). Null: nothing extra.</summary>
+    Type? TopBarEnd => null;
+
+    /// <summary>First status-bar item: where documents are processed.</summary>
+    string WhereProcessed => "offline · on this device";
+
+    /// <summary>Status-bar identity text; null keeps the profile name or "This computer".</summary>
+    string? Identity => null;
+
+    /// <summary>Left-bar global for bringing a document in: label and icon.</summary>
+    string OpenLabel => "Open";
+
+    string OpenIcon => "folder";
+
+    /// <summary>End of the dashboard blurb.</summary>
+    string PrivacyLine => "nothing leaves this device";
+
+    /// <summary>Last line of the settings navigation footer.</summary>
+    string StorageNote => "Stored on this device only";
+
+    /// <summary>Settings › About › Privacy › Network: hint and value.</summary>
+    string NetworkHint => "offline · nothing leaves this device";
+
+    string NetworkValue => "Offline";
+
+    /// <summary>Settings › About › Privacy: show the local data folder path.</summary>
+    bool ShowsDataFolder => true;
+
+    /// <summary>Settings › Library › Search: hint for the text index.</summary>
+    string IndexHint => "Stays on this device";
+
+    /// <summary>Greeting name when the person hasn't set one; null keeps the operating-system user name.</summary>
+    string? DefaultName => null;
+}
+
+/// <summary>Desktop hosts (Windows, Mac, Linux, Android): today's chrome and wording, unchanged.</summary>
+public sealed class DesktopHostChrome : IHostChrome
+{
+}
