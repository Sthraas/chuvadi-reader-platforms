<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-only tooling, same versions as tests/ChuvadiReader.Tests. Never shipped. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ChuvadiReader.Platform\ChuvadiReader.Platform.csproj" />
    <ProjectReference Include="..\..\src\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <!-- The Linux host's pure-.NET parts, compiled in directly (the host itself needs GTK to build). -->
    <Compile Include="..\..\src\ChuvadiReader.Linux\Platform\GtkButtonLayout.cs" Link="GtkButtonLayout.cs" />
    <Compile Include="..\..\src\ChuvadiReader.Linux\Platform\CupsServer.cs" Link="CupsServer.cs" />
    <Compile Include="..\..\src\ChuvadiReader.Linux\Platform\GlibcTrim.cs" Link="GlibcTrim.cs" />
  </ItemGroup>
</Project>
