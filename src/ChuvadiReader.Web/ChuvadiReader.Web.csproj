<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Chuvadi Reader web portal: Blazor Server (Interactive Server rendering) of the unchanged
    ChuvadiReader.Ui, served by Kestrel. Framework only (Microsoft.AspNetCore.App ships with .NET);
    no package references of its own. All document processing comes from Core and the Chuvadi
    libraries it references.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChuvadiReader.Web</RootNamespace>
    <AssemblyName>ChuvadiReader.Web</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared host kit (Foundation): Core's services + platform contracts, registered per connection. -->
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Platform\ChuvadiReader.Platform.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
  </ItemGroup>

  <!--
    WT-11: the published package holds only what runs on the Linux server. No IIS web.config, no
    development settings, no symbols, no API docs. Builds and tests keep their symbols, so stack
    traces in tests still carry line numbers.
  -->
  <PropertyGroup>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Project references bring their own .pdb and .xml as related files; leave them out of the package. -->
  <Target Name="LeaveSymbolsAndDocsOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(Extension)' == '.pdb' or '%(Extension)' == '.xml') and !$([System.String]::Copy('%(RelativePath)').StartsWith('wwwroot'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ChuvadiReader.Web.Tests" />
  </ItemGroup>
</Project>
