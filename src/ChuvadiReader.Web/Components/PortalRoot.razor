@* The portal's interactive root: starts the per-connection browser bridge (viewport reports for the
   form factor, input reports for session expiry), registers this tab with the sign-in it belongs to
   (so a sign-out or expiry anywhere ends it), shows the expiry warning (D-30) and renders the
   unchanged Ui. Portal chrome from the Web portal UI chat lands in the Ui's own platform components. *@
@using ChuvadiReader.Web.Auth
@using ChuvadiReader.Web.Files
@using ChuvadiReader.Web.Platform
@implements IDisposable
@inject ViewportReporter Viewport
@inject OpenTabs Tabs
@inject SessionSpace Space
@inject BrowserBridge Browser
@inject ChuvadiReader.Core.Reader.TabsService Documents
@inject ILogger<PortalRoot> Log
@inject Microsoft.Extensions.Options.IOptions<ChuvadiReader.Web.Hosting.PortalOptions> Options

<MaintenanceBanner />
<ChuvadiReader.Ui.App />
@if (_notice is not null)
{
    <ExpiryWarning Notice="_notice" />
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? Auth { get; set; }

    private IDisposable? _registration;
    private ExpiryNotice? _notice;

    protected override async Task OnInitializedAsync()
    {
        if (Auth is not null)
        {
            var user = (await Auth).User;
            var sub = user.FindFirst("sub")?.Value;
            if (sub is not null)
            {
                _registration = Tabs.Open(sub, user.FindFirst("sid")?.Value, EndAsync, ShowNoticeAsync);
            }
        }
    }

    /// <summary>The session is about to end (or, with null, no longer is).</summary>
    private Task ShowNoticeAsync(ExpiryNotice? notice)
        => InvokeAsync(() =>
        {
            _notice = notice;
            StateHasChanged();
        });

    /// <summary>Called when this tab's sign-in ends elsewhere: files go now, the browser to the signed-out page.</summary>
    private async Task EndAsync()
    {
        // WT-21: close this tab's documents first, so their page images and memory are freed now, not when
        // the connection is cleaned up minutes later. (The cookie is already dead, so nothing could fetch them.)
        try
        {
            await InvokeAsync(() => Documents.CloseAllAsync());
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException or IOException)
        {
            Log.LogDebug("Couldn't close the ended tab's documents: {Message}", ex.Message);
        }

        Space.Delete();
        // Our own one-way call (not NavigationManager, whose awaited navigation can be cancelled in a
        // background tab and then fault the whole circuit). If the browser is gone, nothing is lost:
        // the files are already deleted and the cookie no longer works.
        try
        {
            await Browser.LeaveAsync(SangamSignIn.SignedOutPath, TimeSpan.FromSeconds(10));
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or TaskCanceledException or OperationCanceledException)
        {
            Log.LogDebug("Couldn't send the ended tab to the signed-out page: {Message}", ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Viewport.StartAsync();
                // Input is reported at most once per 1/30 of the idle limit (a minute for 30 minutes).
                var every = TimeSpan.FromTicks(Math.Clamp(Options.Value.IdleTimeout.Ticks / 30, TimeSpan.FromSeconds(5).Ticks, TimeSpan.FromMinutes(1).Ticks));
                await Browser.TrackActivityAsync(every);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
            }
        }
    }

    public void Dispose() => _registration?.Dispose();
}
