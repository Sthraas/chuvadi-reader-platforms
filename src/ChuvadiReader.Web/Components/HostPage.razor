@* The portal's HTML document. It loads the Ui's own stylesheets, fonts and theme.js exactly as the
   Windows host's index.html does, then renders the unchanged ChuvadiReader.Ui.App on the server
   (Interactive Server) inside PortalRoot. Page zoom/pinch is off as in the desktop web views (the Reader
   zooms its own canvas; Foundation HANDOFF). *@
@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <title>Chuvadi</title>
    <link rel="preload" href="_content/ChuvadiReader.Ui/lipi-sans/fonts/LiPi-Sans-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/fonts/google/fonts.css" />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/lipi-sans/lipi-sans.css" />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/css/tokens.css" />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/css/app.css" />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/css/shell.css" />
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/css/prefs.css" />
    @* WT-03: the phone and tablet look (Mobile UI, D-94); every rule is keyed on html[data-shell]. *@
    <link rel="stylesheet" href="_content/ChuvadiReader.Ui/css/mobile.css" />
    <link rel="stylesheet" href="ChuvadiReader.Web.styles.css" />
    <link rel="stylesheet" href="css/portal.css" />
</head>
<body>
    <PortalRoot @rendermode="InteractiveServerNoPrerender" />

    <div id="blazor-error-ui">
        An error occurred. <a href="" class="reload">Reload</a>
    </div>

    <script src="_content/ChuvadiReader.Ui/js/theme.js"></script>
    <script src="js/portal.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // No prerender: the Ui's first render reads per-person settings and talks to the browser
    // (theme, JS modules); prerendering would run it twice and briefly show default settings.
    private static readonly IComponentRenderMode InteractiveServerNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
