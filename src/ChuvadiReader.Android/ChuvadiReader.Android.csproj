<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Chuvadi Reader — Android host (.NET MAUI Blazor Hybrid, Android WebView).

    UI-only host: the whole interface is ChuvadiReader.Ui (unchanged) and all
    document processing is ChuvadiReader.Core → Chuvadi libraries. This project
    only supplies the Android window, the BlazorWebView and the platform services
    (files via the Storage Access Framework, clipboard, links, printing hand-off).

    Packages: only Microsoft's own MAUI / BlazorWebView packages, which the
    maui-android workload provides (programme rule 3).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>ChuvadiReader.Android</RootNamespace>
    <AssemblyName>ChuvadiReader.Android</AssemblyName>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Android 15 (API 35) is the floor; the target API is the SDK's own (API 36 for .NET 10). -->
    <SupportedOSPlatformVersion>35</SupportedOSPlatformVersion>

    <ApplicationTitle>Chuvadi Reader</ApplicationTitle>
    <!--
      PLACEHOLDER — the Play Store application id is permanent once published.
      Arun to decide the final id (see docs/android/DECISIONS.md, A-01).
    -->
    <ApplicationId>in.chuvadi.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Warnings are bugs (programme rule 7). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Play Store upload format. CI also produces a signed .apk for emulator tests. -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <!-- Foundation's platform contracts and shared host kit (platform/foundation, draft). -->
    <ProjectReference Include="..\ChuvadiReader.Platform\ChuvadiReader.Platform.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adaptive icon, drafted from Brand Assets.dc.html (A-09, for Arun's final check). The foreground
         already sits in the 72/108 visible area, so it is not scaled again. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon_foreground.svg" ForegroundScale="1" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F2EAD6" BaseSize="160,160" />
  </ItemGroup>

  <!--
    The app bundles the .NET runtime and .NET for Android, so it carries their own third-party
    notices (Foundation HANDOFF §2b; coordinator decision (a): shown on the Licences page through the
    host-supplied notices contract). Taken from the exact runtime packs this build resolves, so they
    always match what ships. Read back by Platform/RuntimeNotices.cs.
  -->
  <!--
    .NET's and .NET for Android's own third-party notices ship in the app (About › Licences › ".NET runtime").
    Taken from the runtime packs this build actually resolved (AT-19: composing the path from the SDK's version
    properties broke when SDK 10.0.404 resolved a different pack), so the notices always match the runtime shipped.
    Notices are the same for every CPU type: the first pack of each is used. Runs in the outer build, after
    _ResolveAssemblies has gathered every CPU type's files and before the assets are packaged.
  -->
  <Target Name="ChuvadiRuntimeNotices" AfterTargets="_ResolveAssemblies" Condition=" '$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifiers)' == '' ">
    <!-- The packs that System.Private.CoreLib (the .NET runtime) and Mono.Android (.NET for Android) were resolved
         from: their package id and version (Release items point at the trimmed copies, so not their folder). -->
    <PropertyGroup>
      <_ChuvadiNetPack>@(ResolvedFileToPublish->WithMetadataValue('Filename','System.Private.CoreLib')->'%(NuGetPackageId)/%(NuGetPackageVersion)')</_ChuvadiNetPack>
      <_ChuvadiAndroidPack>@(ResolvedFileToPublish->WithMetadataValue('Filename','Mono.Android')->'%(NuGetPackageId)/%(NuGetPackageVersion)')</_ChuvadiAndroidPack>
      <_ChuvadiNetPack>$(_ChuvadiNetPack.Split(';')[0])</_ChuvadiNetPack>
      <_ChuvadiAndroidPack>$(_ChuvadiAndroidPack.Split(';')[0])</_ChuvadiAndroidPack>
      <_ChuvadiDotNetNotices>$(NetCoreTargetingPackRoot)/$(_ChuvadiNetPack)/THIRD-PARTY-NOTICES.TXT</_ChuvadiDotNetNotices>
      <_ChuvadiDotNetNotices Condition="!Exists('$(_ChuvadiDotNetNotices)')">$(NuGetPackageRoot)$(_ChuvadiNetPack.ToLowerInvariant())/THIRD-PARTY-NOTICES.TXT</_ChuvadiDotNetNotices>
      <_ChuvadiAndroidNotices>$(NetCoreTargetingPackRoot)/$(_ChuvadiAndroidPack)/THIRD-PARTY-NOTICES.TXT</_ChuvadiAndroidNotices>
      <_ChuvadiAndroidNotices Condition="!Exists('$(_ChuvadiAndroidNotices)')">$(NuGetPackageRoot)$(_ChuvadiAndroidPack.ToLowerInvariant())/THIRD-PARTY-NOTICES.TXT</_ChuvadiAndroidNotices>
    </PropertyGroup>
    <Message Importance="high" Text="Runtime notices: $(_ChuvadiDotNetNotices); $(_ChuvadiAndroidNotices)" />
    <Error Condition="'$(_ChuvadiNetPack)' == '/' or !Exists('$(_ChuvadiDotNetNotices)')" Text="The app must ship .NET's third-party notices; not found for the resolved runtime pack '$(_ChuvadiNetPack)' ($(_ChuvadiDotNetNotices))." />
    <Error Condition="'$(_ChuvadiAndroidPack)' == '/' or !Exists('$(_ChuvadiAndroidNotices)')" Text="The app must ship .NET for Android's third-party notices; not found for the resolved pack '$(_ChuvadiAndroidPack)' ($(_ChuvadiAndroidNotices))." />
    <ItemGroup>
      <AndroidAsset Include="$(_ChuvadiDotNetNotices)" Link="notices/dotnet-runtime.txt" />
      <AndroidAsset Include="$(_ChuvadiAndroidNotices)" Link="notices/dotnet-android.txt" />
    </ItemGroup>
  </Target>
  <!-- AT-14 test variant: full AOT for Chuvadi's own assemblies (-p:ChuvadiFullAot=true); off by default. -->
  <Import Project="ChuvadiAot.targets" />
</Project>
