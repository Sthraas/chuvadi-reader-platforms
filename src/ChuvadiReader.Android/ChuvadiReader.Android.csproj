<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Chuvadi Reader — Android host (.NET MAUI Blazor Hybrid, Android WebView).

    UI-only host: the whole interface is ChuvadiReader.Ui (unchanged) and all
    document processing is ChuvadiReader.Core → Chuvadi libraries. This project
    only supplies the Android window, the BlazorWebView and the platform services
    (files via the Storage Access Framework, clipboard, links, printing hand-off).

    Packages: only Microsoft's own MAUI / BlazorWebView packages, which the
    maui-android workload provides (programme rule 3).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>ChuvadiReader.Android</RootNamespace>
    <AssemblyName>ChuvadiReader.Android</AssemblyName>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Android 15 (API 35) is the floor; the target API is the SDK's own (API 36 for .NET 10). -->
    <SupportedOSPlatformVersion>35</SupportedOSPlatformVersion>

    <ApplicationTitle>Chuvadi Reader</ApplicationTitle>
    <!--
      PLACEHOLDER — the Play Store application id is permanent once published.
      Arun to decide the final id (see docs/android/DECISIONS.md, A-01).
    -->
    <ApplicationId>in.chuvadi.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Warnings are bugs (programme rule 7). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Play Store upload format. CI also produces a signed .apk for emulator tests. -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <!-- Foundation's platform contracts and shared host kit (platform/foundation, draft). -->
    <ProjectReference Include="..\ChuvadiReader.Platform\ChuvadiReader.Platform.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adaptive icon, drafted from Brand Assets.dc.html (A-09, for Arun's final check). The foreground
         already sits in the 72/108 visible area, so it is not scaled again. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appicon_foreground.svg" ForegroundScale="1" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F2EAD6" BaseSize="160,160" />
  </ItemGroup>

  <!--
    The app bundles the .NET runtime and .NET for Android, so it carries their own third-party
    notices (Foundation HANDOFF §2b; coordinator decision (a): shown on the Licences page through the
    host-supplied notices contract). Taken from the exact runtime packs this build resolves, so they
    always match what ships. Read back by Platform/RuntimeNotices.cs.
  -->
  <Target Name="ChuvadiRuntimeNotices" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <!-- Notices are the same for every CPU type; take them from the first runtime pack this build uses. -->
      <_ChuvadiNoticeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ChuvadiNoticeRid>
      <_ChuvadiNoticeRid Condition="'$(_ChuvadiNoticeRid)' == ''">$([System.String]::Copy('$(RuntimeIdentifiers)').Split(';')[0])</_ChuvadiNoticeRid>
      <_ChuvadiApi>$([System.Version]::Parse('$(TargetPlatformVersion)').Major)</_ChuvadiApi>
      <_ChuvadiDotNetNotices>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Runtime.Mono.$(_ChuvadiNoticeRid)/$(BundledNETCoreAppPackageVersion)/THIRD-PARTY-NOTICES.TXT</_ChuvadiDotNetNotices>
      <_ChuvadiDotNetNotices Condition="!Exists('$(_ChuvadiDotNetNotices)')">$(NuGetPackageRoot)microsoft.netcore.app.runtime.mono.$(_ChuvadiNoticeRid)/$(BundledNETCoreAppPackageVersion)/THIRD-PARTY-NOTICES.TXT</_ChuvadiDotNetNotices>
      <_ChuvadiAndroidNotices>$(NetCoreTargetingPackRoot)/Microsoft.Android.Runtime.$(_ChuvadiApi).android/$(AndroidNETSdkVersion)/THIRD-PARTY-NOTICES.TXT</_ChuvadiAndroidNotices>
      <_ChuvadiAndroidNotices Condition="!Exists('$(_ChuvadiAndroidNotices)')">$(NuGetPackageRoot)microsoft.android.runtime.$(_ChuvadiApi).android/$(AndroidNETSdkVersion)/THIRD-PARTY-NOTICES.TXT</_ChuvadiAndroidNotices>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ChuvadiDotNetNotices)')" Text="The app must ship .NET's third-party notices; not found at $(_ChuvadiDotNetNotices)." />
    <Error Condition="!Exists('$(_ChuvadiAndroidNotices)')" Text="The app must ship .NET for Android's third-party notices; not found at $(_ChuvadiAndroidNotices)." />
    <ItemGroup>
      <AndroidAsset Include="$(_ChuvadiDotNetNotices)" Link="notices/dotnet-runtime.txt" />
      <AndroidAsset Include="$(_ChuvadiAndroidNotices)" Link="notices/dotnet-android.txt" />
    </ItemGroup>
  </Target>
  <!-- AT-14 test variant: full AOT for Chuvadi's own assemblies (-p:ChuvadiFullAot=true); off by default. -->
  <Import Project="ChuvadiAot.targets" />
</Project>
