@inject ChuvadiReader.Platform.IPlatformInfo Platform
@inject ChuvadiReader.Core.Reader.ShellService Shell
@*
    One button on a D-10 rail (Tools, View or Arrange). Icons only until the rail is hovered;
    then the label and shortcut show. Unbuilt features pass DisabledReason: the button is
    greyed out and the reason is its tooltip (the owner wants them visible, not hidden).
*@
<button class="rb @Class @(Active ? "on" : null) @(Primary ? "primary" : null) @(Danger ? "danger" : null) @(Soft ? "off" : null)"
        disabled="@((DisabledReason is not null && !Soft) || Disabled)" aria-disabled="@(Soft ? "true" : null)"
        title="@Tip" aria-label="@Label" aria-pressed="@(Active ? "true" : null)"
        @onclick="Click">
    <Icon Name="@Icon" Size="@Size" />
    <span class="rb-l">@Label</span>
    <span class="rb-k">@(DisabledReason is not null ? "soon" : ShownKeys)</span>
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Keys { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledReason { get; set; }

    /// <summary>With <see cref="DisabledReason"/>: the button looks greyed out but still answers a tap, so its
    /// OnClick can show the reason where a tooltip can't be read (touch screens, D-187).</summary>
    [Parameter] public bool ReasonOnTap { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public int Size { get; set; } = 19;
    [Parameter] public EventCallback OnClick { get; set; }

    private string Tip => DisabledReason is not null
        ? $"{Label} — {DisabledReason}"
        : string.IsNullOrEmpty(Keys) ? Label : $"{Label} ({ShownKeys})";

    // AT-30: on touch shells every greyed button answers a tap with its reason, since a tooltip can't be read there;
    // a button with nothing of its own to do then shows the reason itself. Desktop is unchanged.
    private bool Soft => DisabledReason is not null && !Disabled
        && (ReasonOnTap || ChuvadiReader.Ui.Components.Platform.PlatformText.ReasonOnTap(Platform));

    private Task Click()
    {
        if (Soft && !OnClick.HasDelegate)
        {
            Shell.Notify($"{Label}: {DisabledReason}");
            return Task.CompletedTask;
        }
        return OnClick.InvokeAsync();
    }

    private string? ShownKeys => string.IsNullOrEmpty(Keys) ? Keys : Platform.Keys.Format(Keys);
}
