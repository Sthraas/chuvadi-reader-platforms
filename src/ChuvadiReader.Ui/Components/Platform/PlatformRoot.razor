@using ChuvadiReader.Platform
@implements IDisposable
@inject IPlatformInfo Platform
@inject IJSRuntime JS

@*
    Publishes the platform to the page and to child components.
      * <html data-shell="desktop|tablet|phone|portal" data-platform="windows|macos|linux|android|web"
              data-form-factor="desktop|tablet|phone" data-input="mouse touch pen keyboard"> — CSS for platform components keys on these,
        and reader.js reads data-platform to pick the primary shortcut modifier (Ctrl or ⌘).
      * Cascades a PlatformState that changes when the form factor changes, so layouts re-render.
    Place once, around the app's content.
*@
<CascadingValue Value="_state">
    @ChildContent
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private PlatformState _state = default!;

    protected override void OnInitialized()
    {
        _state = PlatformState.From(Platform);
        Platform.FormFactorChanged += OnFormFactorChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyAsync();
        }
    }

    private void OnFormFactorChanged() => InvokeAsync(async () =>
    {
        _state = PlatformState.From(Platform);
        await ApplyAsync();
        StateHasChanged();
    });

    // Windows desktop is the page default (no attributes), so the Windows host makes no interop call
    // at startup. Every other host sets the attributes once, then again on each form-factor change.
    private async Task ApplyAsync()
    {
        if (_state.Kind == PlatformKind.Windows && _state.FormFactor == FormFactor.Desktop)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("chuvadiTheme.setPlatform", _state.ShellKey, _state.KindKey, _state.FormFactorKey, _state.InputKey);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose() => Platform.FormFactorChanged -= OnFormFactorChanged;
}
