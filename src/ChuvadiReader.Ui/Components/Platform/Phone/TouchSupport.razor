@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IPlatformInfo Info
@inject ShellService Shell

@*
    Touch behaviour for the tablet and phone shells: renders nothing; loads mobile.js, which adds what
    the desktop code lacks on a touchscreen —
      * swipe on a page that fits sideways → next / previous page (Read)
      * tap on the canvas → shows the per-page strip (the desktop shows it on hover)
      * Arrange: long-press a page to drag it; a quick swipe scrolls the desks instead
    Pinch and double-tap zoom are reader.js's own (handout 12g: "pinch, double-tap and swipe do
    zoom and paging"); the tablet desk counter is Bench's (D-46). MainLayout renders this only for
    the tablet and phone layouts, so Windows and the portal pay nothing.
*@

@code {
    private IJSObjectReference? _js;
    private DotNetObjectReference<TouchSupport>? _self;
    private bool _on;
    private bool _arrange;

    private bool Wanted => Info.Shell() is ShellLayout.Tablet or ShellLayout.Phone;

    private bool InArrange => Wanted && Shell.Mode == DocMode.Arrange;

    // Fold / unfold, split screen: a component without parameters isn't re-rendered by its parent.
    protected override void OnInitialized()
    {
        Info.FormFactorChanged += OnChanged;
        Shell.Changed += OnModeMaybeChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnModeMaybeChanged()
    {
        if (InArrange != _arrange)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (Wanted != _on)
            {
                _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChuvadiReader.Ui/js/mobile.js");
                if (Wanted)
                {
                    _self ??= DotNetObjectReference.Create(this);
                    await _js.InvokeVoidAsync("initTouch", _self);
                }
                else
                {
                    await _js.InvokeVoidAsync("disposeTouch");
                    _arrange = false;
                }

                _on = Wanted;
            }

            // Long-press drag needs its blocking touchmove listener in place before the press starts.
            if (_on && _js is not null && InArrange != _arrange)
            {
                _arrange = InArrange;
                await _js.InvokeVoidAsync("setArrange", _arrange);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Horizontal swipe on a page that fits (Read): next (+1) or previous (−1) page or spread.</summary>
    [JSInvokable]
    public Task OnSwipe(int direction)
    {
        if (Shell.Mode != DocMode.Read || !Shell.HasCounter)
        {
            return Task.CompletedTask;
        }

        var target = Shell.CounterCurrent + Math.Sign(direction) * Shell.CounterStep;
        if (target < 1 || target > Shell.CounterTotal)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() => Shell.GoToAsync(target));
    }

    public async ValueTask DisposeAsync()
    {
        Info.FormFactorChanged -= OnChanged;
        Shell.Changed -= OnModeMaybeChanged;
        _self?.Dispose();
        if (_js is null)
        {
            return;
        }

        try
        {
            await _js.InvokeVoidAsync("disposeTouch");
            await _js.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
