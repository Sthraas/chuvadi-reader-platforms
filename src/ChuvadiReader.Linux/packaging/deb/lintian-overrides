# Microsoft's apphost (in both builds): built by Microsoft; shipped as published.
chuvadi-reader: hardening-no-fortify-functions [usr/lib/chuvadi-reader/chuvadi-reader]
chuvadi-reader: binary-has-unneeded-section * [usr/lib/chuvadi-reader/chuvadi-reader]
# The app's own web fonts: loaded by its web view from its own folder, not system fonts.
chuvadi-reader: font-outside-font-dir [usr/lib/chuvadi-reader/wwwroot/*]
chuvadi-reader: font-in-non-font-package [usr/lib/chuvadi-reader/wwwroot/*]
# LiPi Sans's licence stays next to the font, as the SIL Open Font License asks; it's also in copyright.
chuvadi-reader: extra-license-file [usr/lib/chuvadi-reader/wwwroot/_content/ChuvadiReader.Ui/lipi-sans/LICENSE.txt]
chuvadi-reader: package-contains-documentation-outside-usr-share-doc [usr/lib/chuvadi-reader/wwwroot/_content/ChuvadiReader.Ui/lipi-sans/LICENSE.txt]
# The app's own start page (the web view loads it), not documentation.
chuvadi-reader: package-contains-documentation-outside-usr-share-doc [usr/lib/chuvadi-reader/wwwroot/index.html]
