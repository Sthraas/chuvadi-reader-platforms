<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Chuvadi Reader — macOS host (.NET MAUI Blazor Hybrid, Mac Catalyst).
    Hosts the unchanged ChuvadiReader.Ui in WKWebView. Host code only: window,
    file dialogs, clipboard, drag and drop, menus, printing hand-off, storage.
    All document processing stays in ChuvadiReader.Core / the Chuvadi libraries.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>ChuvadiReader.Mac</RootNamespace>
    <AssemblyName>ChuvadiReader.Mac</AssemblyName>

    <ApplicationTitle>Chuvadi</ApplicationTitle>
    <!-- PROVISIONAL bundle id — awaiting Arun's decision (see docs/mac/README.md, "Open decisions"). -->
    <ApplicationId>in.sthraas.chuvadi.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Mac Catalyst 15.0 = macOS 12 Monterey and later. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- Universal app: Apple Silicon + Intel in one bundle (Arun approved). -->
    <RuntimeIdentifiers>maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>

    <!-- Unsigned test builds (no Apple Developer account yet). Signing is documented, not done. -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>

    <!-- Trimming: only .NET's own framework assemblies are trimmed (SdkOnly). Chuvadi libraries and the
         app's own code are kept whole until each library declares trim safety (package report,
         decision 4) — Sheets' typed import/export loses data when it is trimmed. -->
    <MtouchLink>SdkOnly</MtouchLink>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Legal texts in the bundle, unchanged (HANDOFF: "notices in Contents/Resources"; D-82, D-84).
       Contents/Resources/legal/: LICENSE.txt, EULA.txt, THIRD-PARTY-NOTICES.txt from the repo, plus the two
       .NET texts below. All of the repo's texts are DRAFTs until counsel removes the DRAFT line. -->
  <ItemGroup>
    <BundleResource Include="..\..\LICENSE" LogicalName="legal/LICENSE.txt" />
    <BundleResource Include="..\..\legal\EULA.txt" LogicalName="legal/EULA.txt" />
    <BundleResource Include="..\..\legal\THIRD-PARTY-NOTICES.txt" LogicalName="legal/THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- The self-contained .NET's own notices, from the exact runtime packs this build resolved (never a
       copy kept in the repo, so they always match what ships). Fails the build if either is missing.
       Hooked in the way the .NET for Mac Catalyst SDK documents (Xamarin.Shared.targets). In a universal build
       the first resolved pack is used (arm64 and x64 packs carry the same texts). -->
  <PropertyGroup>
    <CollectBundleResourcesDependsOn>$(CollectBundleResourcesDependsOn);ChuvadiDotnetNotices</CollectBundleResourcesDependsOn>
  </PropertyGroup>
  <Target Name="ChuvadiDotnetNotices" DependsOnTargets="ResolveFrameworkReferences">
    <ItemGroup>
      <!-- The .NET runtime pack (Mono on Mac Catalyst), found the way the .NET for Mac Catalyst SDK finds it:
           ResolvedFrameworkReference's RuntimePackName / RuntimePackPath (Xamarin.Shared.Sdk.targets). -->
      <_ChvdMonoPack Include="@(ResolvedFrameworkReference)" Condition="$([System.String]::Copy('%(ResolvedFrameworkReference.RuntimePackName)').StartsWith('Microsoft.NETCore.App.Runtime'))" />
      <_ChvdApplePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.MacCatalyst'" />
    </ItemGroup>
    <PropertyGroup>
      <_ChvdMonoNotices>@(_ChvdMonoPack->'%(RuntimePackPath)')</_ChvdMonoNotices>
      <_ChvdMonoNotices>$(_ChvdMonoNotices.Split(';').GetValue(0))</_ChvdMonoNotices>
      <_ChvdMonoNotices Condition="'$(_ChvdMonoNotices)' != ''">$([System.IO.Path]::Combine('$(_ChvdMonoNotices)', 'THIRD-PARTY-NOTICES.TXT'))</_ChvdMonoNotices>
    </PropertyGroup>
    <!-- The outer step of a universal build has no single RuntimeIdentifier, so no runtime pack is resolved
         there; the packs it downloads for each architecture are listed in _PackageToDownload with their exact
         version. Use the first .NET runtime pack, from the NuGet cache or the SDK's packs folder. -->
    <ItemGroup Condition="'$(_ChvdMonoNotices)' == ''">
      <_ChvdMonoDownload Include="@(_PackageToDownload)" Condition="$([System.String]::Copy('%(_PackageToDownload.Identity)').StartsWith('Microsoft.NETCore.App.Runtime.'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_ChvdMonoNotices)' == ''">
      <_ChvdMonoId>@(_ChvdMonoDownload->'%(Identity)')</_ChvdMonoId>
      <_ChvdMonoId>$(_ChvdMonoId.Split(';').GetValue(0))</_ChvdMonoId>
      <_ChvdMonoVersion>@(_ChvdMonoDownload->'%(Version)')</_ChvdMonoVersion>
      <_ChvdMonoVersion>$(_ChvdMonoVersion.Split(';').GetValue(0).ToString().Trim('[]'))</_ChvdMonoVersion>
      <_ChvdMonoNotices Condition="'$(_ChvdMonoId)' != '' and Exists('$(NuGetPackageRoot)$(_ChvdMonoId.ToLowerInvariant())/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT')">$(NuGetPackageRoot)$(_ChvdMonoId.ToLowerInvariant())/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT</_ChvdMonoNotices>
      <_ChvdMonoNotices Condition="'$(_ChvdMonoNotices)' == '' and '$(_ChvdMonoId)' != '' and Exists('$(NetCoreTargetingPackRoot)/$(_ChvdMonoId)/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT')">$(NetCoreTargetingPackRoot)/$(_ChvdMonoId)/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT</_ChvdMonoNotices>
    </PropertyGroup>
    <!-- Last resort, valid in every build step: the SDK's own table of runtime packs (KnownRuntimePack,
         defined at evaluation) gives the Mono pack's name pattern and the exact runtime version a
         self-contained build uses; the RID is this build's, or the first of the universal list. -->
    <PropertyGroup Condition="'$(_ChvdMonoNotices)' == ''">
      <_ChvdTfm>net$(TargetFrameworkVersion.TrimStart('v'))</_ChvdTfm>
      <_ChvdRid>$(RuntimeIdentifier)</_ChvdRid>
      <_ChvdRid Condition="'$(_ChvdRid)' == ''">$(RuntimeIdentifiers.Split(';').GetValue(0))</_ChvdRid>
    </PropertyGroup>
    <ItemGroup Condition="'$(_ChvdMonoNotices)' == ''">
      <_ChvdKnownMono Include="@(KnownRuntimePack)" Condition="'%(KnownRuntimePack.Identity)' == 'Microsoft.NETCore.App' and '%(KnownRuntimePack.TargetFramework)' == '$(_ChvdTfm)' and '%(KnownRuntimePack.RuntimePackLabels)' == 'Mono'" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_ChvdMonoNotices)' == ''">
      <_ChvdMonoId>@(_ChvdKnownMono->'%(RuntimePackNamePatterns)')</_ChvdMonoId>
      <_ChvdMonoId>$(_ChvdMonoId.Split(';').GetValue(0).ToString().Replace('**RID**', '$(_ChvdRid)'))</_ChvdMonoId>
      <_ChvdMonoVersion>@(_ChvdKnownMono->'%(LatestRuntimeFrameworkVersion)')</_ChvdMonoVersion>
      <_ChvdMonoVersion>$(_ChvdMonoVersion.Split(';').GetValue(0))</_ChvdMonoVersion>
      <_ChvdMonoNotices Condition="'$(_ChvdMonoId)' != '' and Exists('$(NuGetPackageRoot)$(_ChvdMonoId.ToLowerInvariant())/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT')">$(NuGetPackageRoot)$(_ChvdMonoId.ToLowerInvariant())/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT</_ChvdMonoNotices>
      <_ChvdMonoNotices Condition="'$(_ChvdMonoNotices)' == '' and '$(_ChvdMonoId)' != '' and Exists('$(NetCoreTargetingPackRoot)/$(_ChvdMonoId)/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT')">$(NetCoreTargetingPackRoot)/$(_ChvdMonoId)/$(_ChvdMonoVersion)/THIRD-PARTY-NOTICES.TXT</_ChvdMonoNotices>
    </PropertyGroup>
    <PropertyGroup>
      <_ChvdAppleLicense>@(_ChvdApplePack->'%(PackageDirectory)')</_ChvdAppleLicense>
      <_ChvdAppleLicense>$(_ChvdAppleLicense.Split(';').GetValue(0))</_ChvdAppleLicense>
      <_ChvdAppleLicense Condition="'$(_ChvdAppleLicense)' != ''">$([System.IO.Path]::Combine('$(_ChvdAppleLicense)', 'LICENSE'))</_ChvdAppleLicense>
    </PropertyGroup>
    <Error Condition="'$(_ChvdMonoNotices)' == '' or !Exists('$(_ChvdMonoNotices)')" Text="Chuvadi: .NET runtime notices not found in the resolved runtime pack ('$(_ChvdMonoNotices)'). Resolved framework references: @(ResolvedFrameworkReference->'%(Identity)=%(RuntimePackName)@%(RuntimePackPath)', ' | '). Downloaded runtime packs: @(_ChvdMonoDownload->'%(Identity) %(Version)', ' | '). Known Mono pack: $(_ChvdMonoId) $(_ChvdMonoVersion) (RID $(_ChvdRid), TFM $(_ChvdTfm)). NuGet root: $(NuGetPackageRoot). Packs root: $(NetCoreTargetingPackRoot)." />
    <Error Condition="'$(_ChvdAppleLicense)' == '' or !Exists('$(_ChvdAppleLicense)')" Text="Chuvadi: .NET for Mac Catalyst licence not found in the resolved runtime pack ('$(_ChvdAppleLicense)'). Resolved runtime packs: @(ResolvedRuntimePack->'%(FrameworkName)@%(PackageDirectory)', ' | ')" />
    <ItemGroup>
      <BundleResource Include="$(_ChvdMonoNotices)" LogicalName="legal/DOTNET-RUNTIME-THIRD-PARTY-NOTICES.txt" />
      <BundleResource Include="$(_ChvdAppleLicense)" LogicalName="legal/DOTNET-MACCATALYST-LICENSE.txt" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- First-party Microsoft framework packages only (MAUI + its BlazorWebView). -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChuvadiReader.Ui\ChuvadiReader.Ui.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Core\ChuvadiReader.Core.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Platform\ChuvadiReader.Platform.csproj" />
    <ProjectReference Include="..\ChuvadiReader.Hosting\ChuvadiReader.Hosting.csproj" />
  </ItemGroup>
</Project>
