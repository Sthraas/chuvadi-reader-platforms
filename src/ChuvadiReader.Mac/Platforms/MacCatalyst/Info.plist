<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- D-82 / HANDOFF: the shared Copyright value (Directory.Build.props). -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Sthraas Intelligence Pvt Ltd. All rights reserved.</string>
	<!-- Mac Test M-22 / D-148: the system Print panel looks for network printers inside the app, so macOS asks
	     once for local-network access. Without this text it shows its generic "collect data from devices" wording. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Chuvadi looks for printers on your network only when you open the Print panel. Your documents go only to the printer you choose.</string>
	<!-- 6 = Mac idiom ("Optimize Interface for Mac"): the UI renders at 100 %, not scaled to 77 %
	     as iPad-idiom Catalyst apps are, so fonts and layout match the Windows app exactly. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>6</integer>
	</array>
	<!-- Mac Test M-05: the app icon. MauiIcon compiles Resources/AppIcon into this asset set; Mac
	     Catalyst only adds it to Assets.car (and sets CFBundleIconName) when Info.plist names it. -->
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Mac Test M-02: MAUI's documented scene setup, one scene (single window, tabs inside it). macOS
	     delivers files opened with Chuvadi as scene events, at launch and while running. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- "Open With" from Finder: the Open panel's types. Alternate rank — Chuvadi is offered,
	     but never becomes the default app for a type unless the person chooses it. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Word document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.wordprocessingml.document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Excel workbook</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown text</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plain text</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Log file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.log</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Web page</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.html</string>
			</array>
		</dict>
	</array>
	<!-- Opened documents arrive as the original file, not a copy. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
