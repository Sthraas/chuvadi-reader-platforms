<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 6 = Mac idiom ("Optimize Interface for Mac"): the UI renders at 100 %, not scaled to 77 %
	     as iPad-idiom Catalyst apps are, so fonts and layout match the Windows app exactly. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>6</integer>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- One window; documents open as tabs inside it (as on Windows). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
